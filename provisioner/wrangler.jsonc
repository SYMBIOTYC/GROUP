{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "symbiotyc-group-provisioner",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-28",
  "workers_dev": false,
  "preview_urls": false,
  "services": [
    {
      "binding": "GROUP",
      "service": "symbiotyc-group-control-plane"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "persist": true
    }
  }
}
