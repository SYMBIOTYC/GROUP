name = "symbiotyc-group-control-plane"
main = "src/index.mjs"
compatibility_date = "2026-11-28"
workers_dev = false
preview_urls = false

# GROUP is private: workers_dev and preview_urls must stay disabled; attach no
# public routes or custom domains. Do not publish deployment/version URLs.
# AMPHETAMIN is the only intended Service Binding caller. This example is
# intentionally not deployable until D1 exists.
[[d1_databases]]
binding = "DB"
database_name = "symbiotyc-group-compute-state"
database_id = "REPLACE_WITH_APPROVED_D1_DATABASE_ID"
migrations_dir = "migrations"

