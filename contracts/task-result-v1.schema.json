{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.symbiotyc.dev/compute/v1/task-result.schema.json",
  "title": "Symbiotyc Compute TaskResult v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "schema_version",
    "job_id",
    "execution_id",
    "worker_id",
    "lease_id",
    "outcome",
    "finished_at"
  ],
  "properties": {
    "protocol": {
      "const": "symbiotyc.compute.v1"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "job_id": {
      "type": "string",
      "format": "uuid"
    },
    "execution_id": {
      "type": "string",
      "format": "uuid"
    },
    "worker_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "lease_id": {
      "type": "string",
      "minLength": 16,
      "maxLength": 256
    },
    "outcome": {
      "enum": [
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "output": {
      "type": "object"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "type": "string",
          "maxLength": 64
        },
        "message": {
          "type": "string",
          "maxLength": 512
        }
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "sha256",
          "size_bytes",
          "media_type"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "media_type": {
            "type": "string",
            "maxLength": 128
          }
        }
      }
    }
  }
}
