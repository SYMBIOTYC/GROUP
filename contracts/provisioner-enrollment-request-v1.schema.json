{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.symbiotyc.dev/compute/v1/provisioner-enrollment-request.schema.json",
  "title": "Symbiotyc Provisioner Enrollment Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "schema_version",
    "worker_pool",
    "provider",
    "region",
    "runtime",
    "capacity"
  ],
  "properties": {
    "protocol": {
      "const": "symbiotyc.compute.v1"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "worker_pool": {
      "enum": [
        "CLOUD-COMPUTE",
        "CLOUD-CPU",
        "CLOUD-VPS"
      ]
    },
    "provider": {
      "enum": [
        "cloudflare",
        "deno",
        "fly",
        "linux_host",
        "other"
      ]
    },
    "provider_resource_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "region": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "architecture",
        "version"
      ],
      "properties": {
        "os": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "architecture": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu_millis",
        "memory_mib",
        "ephemeral_disk_mib",
        "max_concurrency"
      ],
      "properties": {
        "cpu_millis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "memory_mib": {
          "type": "integer",
          "minimum": 16,
          "maximum": 4194304
        },
        "ephemeral_disk_mib": {
          "type": "integer",
          "minimum": 16,
          "maximum": 4194304
        },
        "max_concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        }
      }
    }
  }
}
