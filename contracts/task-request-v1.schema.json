{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.symbiotyc.dev/compute/v1/task-request.schema.json",
  "title": "Symbiotyc Compute TaskRequest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "schema_version",
    "job_id",
    "execution_id",
    "attempt_number",
    "worker_id",
    "lease_id",
    "lease_epoch",
    "operation_id",
    "input",
    "limits",
    "deadline_at"
  ],
  "properties": {
    "protocol": {
      "const": "symbiotyc.compute.v1"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^1\\\\.[0-9]+$"
    },
    "job_id": {
      "type": "string",
      "format": "uuid"
    },
    "execution_id": {
      "type": "string",
      "format": "uuid"
    },
    "attempt_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "worker_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "lease_id": {
      "type": "string",
      "minLength": 16,
      "maxLength": 256
    },
    "lease_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$"
    },
    "input": {
      "type": "object",
      "maxProperties": 128
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu_millis",
        "memory_mib",
        "timeout_seconds",
        "max_output_bytes"
      ],
      "properties": {
        "cpu_millis": {
          "type": "integer",
          "minimum": 1
        },
        "memory_mib": {
          "type": "integer",
          "minimum": 16
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "deadline_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "maxLength": 128
    }
  }
}
